{"data": {"conn_name": "model.healthcare_proj.stg_claims", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "9537b4f9029d7124a033b8e2d43c2dd4d64a2270d5bd5e61990c69d28fcfb43e", "node_finished_at": "", "node_name": "stg_claims", "node_path": "staging/stg_claims.sql", "node_relation": {"alias": "stg_claims", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_staging.stg_claims", "schema": "STAGING_staging"}, "node_started_at": "2026-08-15T21:05:23.230766", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.stg_claims"}, "sql": "create or replace   view HEALTHCARE_DB.STAGING_staging.stg_claims\n  \n  \n  \n  \n  as (\n    with source as(\n    select * from HEALTHCARE_DB.RAW.claims\n),\ncleaned as (\n    select\n        claim_id,\n        patient_id,\n        encounter_id,\n        payer_id,\n        initcap(trim(claim_type)) as claim_type,\n        submitted_date,\n        paid_date\n        --financial data\n        billed_amount,\n        paid_amount,\n        allowed_amount,\n        --claim status\n        initcap(trim(claim_status)) as claim_status\n        from source\n)\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_claims\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On model.healthcare_proj.stg_claims: create or replace   view HEALTHCARE_DB.STAGING_staging.stg_claims\n  \n  \n  \n  \n  as (\n    with source as(\n    select * from HEALTHCARE_DB.RAW.claims\n),\ncleaned as (\n    select\n        claim_id,\n        patient_id,\n        encounter_id,\n        payer_id,\n        initcap(trim(claim_type)) as claim_type,\n        submitted_date,\n        paid_date\n        --financial data\n        billed_amount,\n        paid_amount,\n        allowed_amount,\n        --claim status\n        initcap(trim(claim_status)) as claim_status\n        from source\n)\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_claims\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-2 (worker)", "ts": "2026-08-15T21:05:23.359753Z"}}
