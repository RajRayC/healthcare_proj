{"data": {"conn_name": "snapshot.healthcare_proj.snap_provider", "node_info": {"materialized": "snapshot", "meta": {}, "node_checksum": "a78b27089cd161a504cbcbe54e1b0542fdfe62fd5eedd6dfaafda09a5f0b734f", "node_finished_at": "", "node_name": "snap_provider", "node_path": "snap_provider.sql", "node_relation": {"alias": "snap_provider", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.snapshots.snap_provider", "schema": "snapshots"}, "node_started_at": "2026-08-15T21:05:23.234448", "node_status": "executing", "resource_type": "snapshot", "unique_id": "snapshot.healthcare_proj.snap_provider"}, "sql": "merge into \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PROVIDER\" as DBT_INTERNAL_DEST\n    using \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PROVIDER__dbt_tmp\" as DBT_INTERNAL_SOURCE\n    on DBT_INTERNAL_SOURCE.dbt_scd_id = DBT_INTERNAL_DEST.dbt_scd_id\n\n    when matched\n     \n       and DBT_INTERNAL_DEST.dbt_valid_to is null\n     \n     and DBT_INTERNAL_SOURCE.dbt_change_type in ('update', 'delete')\n        then update\n        set dbt_valid_to = DBT_INTERNAL_SOURCE.dbt_valid_to\n\n    when not matched\n     and DBT_INTERNAL_SOURCE.dbt_change_type = 'insert'\n        then insert (\"PROVIDER_ID\", \"PROVIDER_NAME\", \"PROVIDER_SPECIALTY\", \"DBT_UPDATED_AT\", \"DBT_VALID_FROM\", \"DBT_VALID_TO\", \"DBT_SCD_ID\")\n        values (\"PROVIDER_ID\", \"PROVIDER_NAME\", \"PROVIDER_SPECIALTY\", \"DBT_UPDATED_AT\", \"DBT_VALID_FROM\", \"DBT_VALID_TO\", \"DBT_SCD_ID\")\n\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_provider\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On snapshot.healthcare_proj.snap_provider: merge into \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PROVIDER\" as DBT_INTERNAL_DEST\n    using \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PROVIDER__dbt_tmp\" as DBT_INTERNAL_SOURCE\n    on DBT_INTERNAL_SOURCE.dbt_scd_id = DBT_INTERNAL_DEST.dbt_scd_id\n\n    when matched\n     \n       and DBT_INTERNAL_DEST.dbt_valid_to is null\n     \n     and DBT_INTERNAL_SOURCE.dbt_change_type in ('update', 'delete')\n        then update\n        set dbt_valid_to = DBT_INTERNAL_SOURCE.dbt_valid_to\n\n    when not matched\n     and DBT_INTERNAL_SOURCE.dbt_change_type = 'insert'\n        then insert (\"PROVIDER_ID\", \"PROVIDER_NAME\", \"PROVIDER_SPECIALTY\", \"DBT_UPDATED_AT\", \"DBT_VALID_FROM\", \"DBT_VALID_TO\", \"DBT_SCD_ID\")\n        values (\"PROVIDER_ID\", \"PROVIDER_NAME\", \"PROVIDER_SPECIALTY\", \"DBT_UPDATED_AT\", \"DBT_VALID_FROM\", \"DBT_VALID_TO\", \"DBT_SCD_ID\")\n\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_provider\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-6 (worker)", "ts": "2026-08-15T21:05:24.752148Z"}}
