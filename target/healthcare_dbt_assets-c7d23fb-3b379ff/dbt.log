{"data": {"conn_name": "snapshot.healthcare_proj.snap_patient_insurance", "node_info": {"materialized": "snapshot", "meta": {}, "node_checksum": "7f3663aff64d571d88eb7f921319604171ceba644f90bdb1668c8d4bfe886c7d", "node_finished_at": "", "node_name": "snap_patient_insurance", "node_path": "snap_patient_insurance.sql", "node_relation": {"alias": "snap_patient_insurance", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.snapshots.snap_patient_insurance", "schema": "snapshots"}, "node_started_at": "2026-08-15T21:05:23.233627", "node_status": "executing", "resource_type": "snapshot", "unique_id": "snapshot.healthcare_proj.snap_patient_insurance"}, "sql": "create or replace temporary table \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PATIENT_INSURANCE__dbt_tmp\"\nas (\n    \n    \n    with snapshot_query as (\n\n        \n\n\nselect \npatient_id,\ninsurance_id,\ninsurance_type\nfrom\nHEALTHCARE_DB.RAW.patients\n\n    ),\n\n    snapshotted_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n\n        from \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PATIENT_INSURANCE\"\n        where\n            \n                dbt_valid_to is null\n            \n\n    ),\n\n    insertions_source_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_updated_at,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_from,\n            \n  \n  coalesce(nullif(to_timestamp_ntz(convert_timezone('UTC', current_timestamp())), to_timestamp_ntz(convert_timezone('UTC', current_timestamp()))), null)\n  as dbt_valid_to\n,\n            md5(coalesce(cast(patient_id as varchar ), '')\n         || '|' || coalesce(cast(to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as varchar ), '')\n        ) as dbt_scd_id\n\n        from snapshot_query\n    ),\n\n    updates_source_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_updated_at,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_from,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_to\n\n        from snapshot_query\n    ),\n\n    insertions as (\n\n        select\n            'insert' as dbt_change_type,\n            source_data.*\n\n        from insertions_source_data as source_data\n        left outer join snapshotted_data\n            on \n    \n        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key\n    \n\n            where \n    \n        snapshotted_data.dbt_unique_key is null\n    \n\n            or (\n    \n        snapshotted_data.dbt_unique_key is not null\n    \n and (\n               (snapshotted_data.\"INSURANCE_ID\" != source_data.\"INSURANCE_ID\"\n        or\n        (\n            ((snapshotted_data.\"INSURANCE_ID\" is null) and not (source_data.\"INSURANCE_ID\" is null))\n            or\n            ((not snapshotted_data.\"INSURANCE_ID\" is null) and (source_data.\"INSURANCE_ID\" is null))\n        ))\n            )\n\n        )\n\n    ),\n\n    updates as (\n\n        select\n            'update' as dbt_change_type,\n            source_data.*,\n            snapshotted_data.dbt_scd_id\n\n        from updates_source_data as source_data\n        join snapshotted_data\n            on \n    \n        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key\n    \n\n        where (\n            (snapshotted_data.\"INSURANCE_ID\" != source_data.\"INSURANCE_ID\"\n        or\n        (\n            ((snapshotted_data.\"INSURANCE_ID\" is null) and not (source_data.\"INSURANCE_ID\" is null))\n            or\n            ((not snapshotted_data.\"INSURANCE_ID\" is null) and (source_data.\"INSURANCE_ID\" is null))\n        ))\n        )\n    )\n\n    select * from insertions\n    union all\n    select * from updates\n\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_patient_insurance\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On snapshot.healthcare_proj.snap_patient_insurance: create or replace temporary table \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PATIENT_INSURANCE__dbt_tmp\"\nas (\n    \n    \n    with snapshot_query as (\n\n        \n\n\nselect \npatient_id,\ninsurance_id,\ninsurance_type\nfrom\nHEALTHCARE_DB.RAW.patients\n\n    ),\n\n    snapshotted_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n\n        from \"HEALTHCARE_DB\".\"SNAPSHOTS\".\"SNAP_PATIENT_INSURANCE\"\n        where\n            \n                dbt_valid_to is null\n            \n\n    ),\n\n    insertions_source_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_updated_at,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_from,\n            \n  \n  coalesce(nullif(to_timestamp_ntz(convert_timezone('UTC', current_timestamp())), to_timestamp_ntz(convert_timezone('UTC', current_timestamp()))), null)\n  as dbt_valid_to\n,\n            md5(coalesce(cast(patient_id as varchar ), '')\n         || '|' || coalesce(cast(to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as varchar ), '')\n        ) as dbt_scd_id\n\n        from snapshot_query\n    ),\n\n    updates_source_data as (\n\n        select *, \n    \n        patient_id as dbt_unique_key\n    \n,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_updated_at,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_from,\n            to_timestamp_ntz(convert_timezone('UTC', current_timestamp())) as dbt_valid_to\n\n        from snapshot_query\n    ),\n\n    insertions as (\n\n        select\n            'insert' as dbt_change_type,\n            source_data.*\n\n        from insertions_source_data as source_data\n        left outer join snapshotted_data\n            on \n    \n        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key\n    \n\n            where \n    \n        snapshotted_data.dbt_unique_key is null\n    \n\n            or (\n    \n        snapshotted_data.dbt_unique_key is not null\n    \n and (\n               (snapshotted_data.\"INSURANCE_ID\" != source_data.\"INSURANCE_ID\"\n        or\n        (\n            ((snapshotted_data.\"INSURANCE_ID\" is null) and not (source_data.\"INSURANCE_ID\" is null))\n            or\n            ((not snapshotted_data.\"INSURANCE_ID\" is null) and (source_data.\"INSURANCE_ID\" is null))\n        ))\n            )\n\n        )\n\n    ),\n\n    updates as (\n\n        select\n            'update' as dbt_change_type,\n            source_data.*,\n            snapshotted_data.dbt_scd_id\n\n        from updates_source_data as source_data\n        join snapshotted_data\n            on \n    \n        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key\n    \n\n        where (\n            (snapshotted_data.\"INSURANCE_ID\" != source_data.\"INSURANCE_ID\"\n        or\n        (\n            ((snapshotted_data.\"INSURANCE_ID\" is null) and not (source_data.\"INSURANCE_ID\" is null))\n            or\n            ((not snapshotted_data.\"INSURANCE_ID\" is null) and (source_data.\"INSURANCE_ID\" is null))\n        ))\n        )\n    )\n\n    select * from insertions\n    union all\n    select * from updates\n\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_patient_insurance\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-5 (wo