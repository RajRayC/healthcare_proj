{"data": {"conn_name": "model.healthcare_proj.fact_encounters", "node_info": {"materialized": "incremental", "meta": {}, "node_checksum": "6ea4cd27fcea68d0b436a51e89698514f640d972413e35b1418d84ab5bc824e0", "node_finished_at": "", "node_name": "fact_encounters", "node_path": "marts/core/fact_encounters.sql", "node_relation": {"alias": "fact_encounters", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_marts.fact_encounters", "schema": "STAGING_marts"}, "node_started_at": "2026-08-15T21:05:23.502254", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.fact_encounters"}, "sql": "create or replace  temporary view HEALTHCARE_DB.STAGING_marts.fact_encounters__dbt_tmp\n  \n  \n  \n  \n  as (\n    \n\nwith encounters as(\n    select *\n    from HEALTHCARE_DB.STAGING_staging.stg_encounters\n),\ndx as (\n    select *\n    from HEALTHCARE_DB.RAW.diagnoses\n),\nmds as (\n    select *\n    from HEALTHCARE_DB.RAW.medications\n),\npivots as\n(\n    --diagnoses\n    select\n    encounter_id,\n    count(*) as diagnosis_count,\n    max(case when icd10_code like 'I%' then 1 else 0 end) as has_cardiovascular_dx,\n    max(case when icd10_code like 'J%' then 1 else 0 end) as has_respiratory_dx,\n    count(distinct medication_id) as distinct_medication_count\n    from dx\n    left join mds using(encounter_id)\n    group by encounter_id\n)\nselect \n    encounters.*,\n    pivots.diagnosis_count,\n    pivots.has_cardiovascular_dx,\n    pivots.has_respiratory_dx,\n    pivots.distinct_medication_count\nfrom encounters\nleft join pivots using(encounter_id)\n\n\n  where encounters.encounter_date > (select max(encounter_date) from HEALTHCARE_DB.STAGING_marts.fact_encounters)\n\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.fact_encounters\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On model.healthcare_proj.fact_encounters: create or replace  temporary view HEALTHCARE_DB.STAGING_marts.fact_encounters__dbt_tmp\n  \n  \n  \n  \n  as (\n    \n\nwith encounters as(\n    select *\n    from HEALTHCARE_DB.STAGING_staging.stg_encounters\n),\ndx as (\n    select *\n    from HEALTHCARE_DB.RAW.diagnoses\n),\nmds as (\n    select *\n    from HEALTHCARE_DB.RAW.medications\n),\npivots as\n(\n    --diagnoses\n    select\n    encounter_id,\n    count(*) as diagnosis_count,\n    max(case when icd10_code like 'I%' then 1 else 0 end) as has_cardiovascular_dx,\n    max(case when icd10_code like 'J%' then 1 else 0 end) as has_respiratory_dx,\n    count(distinct medication_id) as distinct_medication_count\n    from dx\n    left join mds using(encounter_id)\n    group by encounter_id\n)\nselect \n    encounters.*,\n    pivots.diagnosis_count,\n    pivots.has_cardiovascular_dx,\n    pivots.has_respiratory_dx,\n    pivots.distinct_medication_count\nfrom encounters\nleft join pivots using(encounter_id)\n\n\n  where encounters.encounter_date > (select max(encounter_date) from HEALTHCARE_DB.STAGING_marts.fact_encounters)\n\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.fact_encounters\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-8 (worker)", "ts": "2026-08-15T21:05:23.621212Z"}}
