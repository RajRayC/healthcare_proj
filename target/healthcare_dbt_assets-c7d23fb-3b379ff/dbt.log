{"data": {"conn_name": "model.healthcare_proj.int_patient_encounters", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "71546f8ccfdb996f556bc686528e5f02f69bc877adfeab97bf7e5233eff64b90", "node_finished_at": "", "node_name": "int_patient_encounters", "node_path": "intermediate/int_patient_encounters.sql", "node_relation": {"alias": "int_patient_encounters", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_intermediate.int_patient_encounters", "schema": "STAGING_intermediate"}, "node_started_at": "2026-08-15T21:05:24.007858", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.int_patient_encounters"}, "sql": "create or replace   view HEALTHCARE_DB.STAGING_intermediate.int_patient_encounters\n  \n  \n  \n  \n  as (\n    with patients as (\n    select * from HEALTHCARE_DB.STAGING_staging.stg_patients\n),\nencounters as (\n    select * from HEALTHCARE_DB.STAGING_staging.stg_encounters\n),\ndiagnoses as (\n    select * from HEALTHCARE_DB.RAW.diagnoses\n),\nproviders as (\n    select * from HEALTHCARE_DB.RAW.providers\n),\njoined as (\n    select\n        e.encounter_id,\n        e.patient_id,\n        e.provider_id,\n        e.facility_id,\n        e.encounter_type,\n        e.encounter_date,\n        e.discharge_date,\n        e.discharge_disposition,\n\n        --patient data\n        full_name,\n        gender,\n        race,\n        state,\n        insurance_type\n\n        --provider info\n        provider_name,\n        specialty,\n        npi\n\n    from encounters e\n    left join patients p on e.patient_id=p.patient_id\n    left join providers prov on p.pcp_provider_id=prov.provider_id\n\n)\n\nselect * from joined\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.int_patient_encounters\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On model.healthcare_proj.int_patient_encounters: create or replace   view HEALTHCARE_DB.STAGING_intermediate.int_patient_encounters\n  \n  \n  \n  \n  as (\n    with patients as (\n    select * from HEALTHCARE_DB.STAGING_staging.stg_patients\n),\nencounters as (\n    select * from HEALTHCARE_DB.STAGING_staging.stg_encounters\n),\ndiagnoses as (\n    select * from HEALTHCARE_DB.RAW.diagnoses\n),\nproviders as (\n    select * from HEALTHCARE_DB.RAW.providers\n),\njoined as (\n    select\n        e.encounter_id,\n        e.patient_id,\n        e.provider_id,\n        e.facility_id,\n        e.encounter_type,\n        e.encounter_date,\n        e.discharge_date,\n        e.discharge_disposition,\n\n        --patient data\n        full_name,\n        gender,\n        race,\n        state,\n        insurance_type\n\n        --provider info\n        provider_name,\n        specialty,\n        npi\n\n    from encounters e\n    left join patients p on e.patient_id=p.patient_id\n    left join providers prov on p.pcp_provider_id=prov.provider_id\n\n)\n\nselect * from joined\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.int_patient_encounters\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-4 (worker)", "ts": "2026-08-15T21:05:24.023968Z"}}
