{"data": {"conn_name": "model.healthcare_proj.stg_encounters", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "86092a46c295c8b32fd5c525d121fe3c2645c0c72f92e217e9d12ae4be5a69f3", "node_finished_at": "", "node_name": "stg_encounters", "node_path": "staging/stg_encounters.sql", "node_relation": {"alias": "stg_encounters", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_staging.stg_encounters", "schema": "STAGING_staging"}, "node_started_at": "2026-08-15T21:05:23.231185", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.stg_encounters"}, "sql": "create or replace   view HEALTHCARE_DB.STAGING_staging.stg_encounters\n  \n  \n  \n  \n  as (\n    with source as (\n    select * from HEALTHCARE_DB.RAW.encounters\n),\ncleaned as (\n    select \n        --ids\n        encounter_id,\n        patient_id,\n        provider_id,\n        facility_id,\n        initcap(trim(encounter_type)) as encounter_type,\n        --date validations\n        encounter_date,\n        discharge_date,\n        case when discharge_date is not null and discharge_date> encounter_date then true else false end as valid_stay,\n        discharge_disposition\n    from source\n)\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_encounters\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On model.healthcare_proj.stg_encounters: create or replace   view HEALTHCARE_DB.STAGING_staging.stg_encounters\n  \n  \n  \n  \n  as (\n    with source as (\n    select * from HEALTHCARE_DB.RAW.encounters\n),\ncleaned as (\n    select \n        --ids\n        encounter_id,\n        patient_id,\n        provider_id,\n        facility_id,\n        initcap(trim(encounter_type)) as encounter_type,\n        --date validations\n        encounter_date,\n        discharge_date,\n        case when discharge_date is not null and discharge_date> encounter_date then true else false end as valid_stay,\n        discharge_disposition\n    from source\n)\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_encounters\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-3 (worker)", "ts": "2026-08-15T21:05:23.360983Z"}}
