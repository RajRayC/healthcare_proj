VIDER_NAME\" is null))\n            or\n            ((not snapshotted_data.\"PROVIDER_NAME\" is null) and (source_data.\"PROVIDER_NAME\" is null))\n        ) or snapshotted_data.\"PROVIDER_SPECIALTY\" != source_data.\"PROVIDER_SPECIALTY\"\n        or\n        (\n            ((snapshotted_data.\"PROVIDER_SPECIALTY\" is null) and not (source_data.\"PROVIDER_SPECIALTY\" is null))\n            or\n            ((not snapshotted_data.\"PROVIDER_SPECIALTY\" is null) and (source_data.\"PROVIDER_SPECIALTY\" is null))\n        ))\n        )\n    )\n\n    select * from insertions\n    union all\n    select * from updates\n\n    ) as __dbt_sbq\n    where false\n    limit 0\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_provider\"} */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"snapshot.healthcare_proj.snap_provider\"} */", "name": "SQLQuery", "pid": 98239, "thread": "Thread-6 (worker)", "ts": "2026-08-15T21:05:24.540882Z"}}
