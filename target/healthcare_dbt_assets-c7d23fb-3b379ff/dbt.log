{"data": {"conn_name": "model.healthcare_proj.stg_patients", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "2519bb57a17a62c1368e711b0c8856c6cbfc137186c2ef75357800102c7625bd", "node_finished_at": "", "node_name": "stg_patients", "node_path": "staging/stg_patients.sql", "node_relation": {"alias": "stg_patients", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_staging.stg_patients", "schema": "STAGING_staging"}, "node_started_at": "2026-08-15T21:05:23.231513", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.stg_patients"}, "sql": "create or replace   view HEALTHCARE_DB.STAGING_staging.stg_patients\n  \n  \n  \n  \n  as (\n    with source as (\n    select * from HEALTHCARE_DB.RAW.patients\n)\n,\ncleaned as (\n    select \n        patient_id,\n        --name cleaning\n        initcap(trim(first_name)) as first_name,\n        initcap(trim(last_name)) as last_name,\n        initcap(trim(first_name)) || ' ' || initcap(trim(last_name)) as full_name,\n        dob as dateofbirth,\n        floor(datediff(day, dob, current_date()) / 365.25) as current_age,\n        case\n        when floor(datediff(day, dob, current_date()) / 365.25) < 18 then 'Child'\n        when floor(datediff(day, dob, current_date()) / 365.25) between 18 and 64 then 'Adult'\n        else 'Senior'\n        end as age_group,\n        upper(trim(gender)) as gender,\n        trim(race) as race,\n        trim(ethnicity) as ethnicity,\n        zip_code,\n        upper(state) as state,\n        insurance_type,\n        insurance_id,\n        pcp_provider_id\n    from source\n)\n\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_patients\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2c18f178-ed3d-4118-b898-51bf79a16efb", "level": "debug", "msg": "On model.healthcare_proj.stg_patients: create or replace   view HEALTHCARE_DB.STAGING_staging.stg_patients\n  \n  \n  \n  \n  as (\n    with source as (\n    select * from HEALTHCARE_DB.RAW.patients\n)\n,\ncleaned as (\n    select \n        patient_id,\n        --name cleaning\n        initcap(trim(first_name)) as first_name,\n        initcap(trim(last_name)) as last_name,\n        initcap(trim(first_name)) || ' ' || initcap(trim(last_name)) as full_name,\n        dob as dateofbirth,\n        floor(datediff(day, dob, current_date()) / 365.25) as current_age,\n        case\n        when floor(datediff(day, dob, current_date()) / 365.25) < 18 then 'Child'\n        when floor(datediff(day, dob, current_date()) / 365.25) between 18 and 64 then 'Adult'\n        else 'Senior'\n        end as age_group,\n        upper(trim(gender)) as gender,\n        trim(race) as race,\n        trim(ethnicity) as ethnicity,\n        zip_code,\n        upper(state) as state,\n        insurance_type,\n        insurance_id,\n        pcp_provider_id\n    from source\n)\n\nselect * from cleaned\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"healthcare_proj\", \"target_name\": \"prod\", \"node_id\": \"model.healthcare_proj.stg_patients\"} */;", "name": "SQLQuery", "pid": 98239, "thread": "Thread-4 (worker)", "ts": "2026-08-15T21:05:23.362134Z"}}
