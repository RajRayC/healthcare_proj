{"data": {"conn_name": "model.healthcare_proj.fact_encounters", "node_info": {"materialized": "incremental", "meta": {}, "node_checksum": "6ea4cd27fcea68d0b436a51e89698514f640d972413e35b1418d84ab5bc824e0", "node_finished_at": "", "node_name": "fact_encounters", "node_path": "marts/core/fact_encounters.sql", "node_relation": {"alias": "fact_encounters", "database": "HEALTHCARE_DB", "relation_name": "HEALTHCARE_DB.STAGING_marts.fact_encounters", "schema": "STAGING_marts"}, "node_started_at": "2026-08-15T21:05:23.502254", "node_status": "executing", "resource_type": "model", "unique_id": "model.healthcare_proj.fact_encounters"}, "sql": "merge into HEALTHCARE_DB.STAGING_marts.fact_encounters as DBT_INTERNAL_DEST\n        using HEALTHCARE_DB.STAGING_marts.fact_encounters__dbt_tmp as DBT_INTERNAL_SOURCE\n        on ((DBT_INTERNAL_SOURCE.encounter_id = DBT_INTERNAL_DEST.encounter_id))\n\n    \n    when matched then update set\n        \"ENCOUNTER_ID\" = DBT_INTERNAL_SOURCE.\"ENCOUNTER_ID\",\"PATIENT_ID\" = DBT_INTERNAL_SOURCE.\"PATIENT_ID\",\"PROVIDER_ID\" = DBT_INTERNAL_SOURCE.\"PROVIDER_ID\",\"FACILITY_ID\" = DBT_INTERNAL_SOURCE.\"FACILITY_ID\",\"ENCOUNTER_TYPE\" = DBT_INTERNAL_SOURCE.\"ENCOUNTER_TYPE\",\"ENCOUNTER_DATE\" = DBT_INTERNAL_SOURCE.\"ENCOUNTER_DATE\",\"DISCHARGE_DATE\" = DBT_INTERNAL_SOURCE.\"DISCHARGE_DATE\",\"VALID_STAY\" = DBT_INTERNAL_SOURCE.\"VALID_STAY\",\"DISCHARGE_DISPOSITION\" = DBT_INTERNAL_SOURCE.\"DISCHARGE_DISPOSITION\",\"DIAGNOSIS_COUNT\" = DBT_INTERNAL_SOURCE.\"DIAGNOSIS_COUNT\",\"HAS_CARDIOVASCULAR_DX\" = DBT_INTERNAL_SOURCE.\"HAS_CARDIOVASCULAR_DX\",\"HAS_RESPIRATORY_DX\" = DBT_INTERNAL_SOURCE.\"HAS_RESPIRATORY_DX\",\"DISTINCT_MEDICATION_COUNT\" = DBT_INTERNAL_SOURCE.\"DISTINCT_MEDICATION_COUNT\"\n    \n\n    when not matched then insert\n        (\"ENCOUNTER_ID\", \"PATIENT_ID\", \"PROVIDER_ID\", \"FACILITY_ID\", \"ENCOUNTER_TYPE\", \"ENCOUNTER_DATE\", \"DISCHARGE_DATE\", \"VALID_STAY\", \"DISCHARGE_DISPOSITION\", \"DIAGNOSIS_COUNT\", \"HAS_